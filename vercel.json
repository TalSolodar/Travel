{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "destination": "/en",
      "permanent": false
    },
    {
      "source": "/vietnam",
      "destination": "/en/vietnam",
      "permanent": true
    },
    {
      "source": "/vietnam/:step",
      "destination": "/en/vietnam/:step",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/en",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/en/privacy-and-disclosure",
      "permanent": true
    },
    {
      "source": "/affiliate-disclosure",
      "destination": "/en/privacy-and-disclosure",
      "permanent": true
    },
    {
      "source": "/en/about",
      "destination": "/en",
      "permanent": true
    },
    {
      "source": "/he/about",
      "destination": "/he",
      "permanent": true
    },
    {
      "source": "/en/privacy",
      "destination": "/en/privacy-and-disclosure",
      "permanent": true
    },
    {
      "source": "/en/affiliate-disclosure",
      "destination": "/en/privacy-and-disclosure",
      "permanent": true
    },
    {
      "source": "/he/privacy",
      "destination": "/he/privacy-and-disclosure",
      "permanent": true
    },
    {
      "source": "/he/affiliate-disclosure",
      "destination": "/he/privacy-and-disclosure",
      "permanent": true
    }
  ]
}
